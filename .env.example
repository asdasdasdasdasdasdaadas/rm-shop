# Скопируйте: cp .env.example .env
# Дальше заполните значения. Пустые поля с пометкой ОБЯЗАТЕЛЬНО бот не запустит.
# На сервере не коммитьте .env. Пароль Postgres без символов @ : / #

# ============================================================
# 1. TELEGRAM-БОТ
# ============================================================
BOT_TOKEN=                          # ОБЯЗАТЕЛЬНО. Токен от @BotFather
BOT_USERNAME=your_bot               # без @
BRAND_NAME=RM Shop                  # название бота и сервиса: приветствие, кабинет, имя в Telegram
SUPPORT_USERNAME=@way_proxy_support  # ссылка «Поддержка» в боте и кабинете
# Telegram ID админов через запятую (команда /admin)
ADMIN_IDS=
# Пароль веб-админки http://127.0.0.1:8080/admin
ADMIN_PASSWORD=

# ============================================================
# 2. КАНАЛ (проверка подписки)
# ============================================================
REQUIRED_CHANNEL_ID=@your_channel   # ОБЯЗАТЕЛЬНО. @channel или -100...
REQUIRED_CHANNEL_URL=https://t.me/your_channel

# ============================================================
# 3. ПАНЕЛЬ REMNAWAVE
# ============================================================
REMNAWAVE_BASE_URL=https://panel.example.com   # ОБЯЗАТЕЛЬНО, без /api
REMNAWAVE_TOKEN=                    # ОБЯЗАТЕЛЬНО. API Token из панели
REMNAWAVE_SQUAD_UUIDS=              # UUID Internal Squads через запятую
REMNAWAVE_HWID_LIMIT=1              # лимит устройств, 0 = без лимита
REMNAWAVE_TRAFFIC_LIMIT_GB=0        # 0 = безлимит
REMNAWAVE_TRAFFIC_STRATEGY=NO_RESET

# ============================================================
# 4. ПОДПИСКА И ОПЛАТА
# ============================================================
TRIAL_ENABLED=true                  # кнопка «Попробовать бесплатно»
TRIAL_DAYS=3                        # сколько дней даётся бесплатно
REFERRAL_REWARD_DAYS=7
REFERRAL_INVITEE_DAYS=5
# Цены в рублях для RollyPay
PLAN_1M_RUB=199
PLAN_3M_RUB=499
PLAN_6M_RUB=899
PLAN_12M_RUB=1499
# Telegram Stars (если STARS_ENABLED=true)
STARS_ENABLED=false
PLAN_1M_STARS=150
PLAN_3M_STARS=400
PLAN_6M_STARS=700
PLAN_12M_STARS=1200

# ============================================================
# 4.1 ROLLYPAY  https://docs.rollypay.io
# ============================================================
# API-ключ кассы (rpk_live_... / rpk_test_...), не signing_secret. Без кавычек.
# Если в ключе есть $, для Docker Compose удвойте: $$
ROLLYPAY_API_URL=https://rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# true = тестовые платежи (test: true), без реальных денег
ROLLYPAY_TEST=true
# Пусто = выбор способа на форме. Можно sbp / card
ROLLYPAY_PAYMENT_METHOD=

# На кассе укажите callback_url:
# https://ваш-домен/webhooks/rollypay

# ============================================================
# 5. РЕЖИМ КАБИНЕТА
# ============================================================
# false — подписка на срок (месяцы)
# true  — баланс в рублях, устройства, списание за сутки
BALANCE_ENABLED=false
VPN_DAY_PRICE_RUB=6
BALANCE_TOPUP_MIN=50
BALANCE_TOPUP_MAX=400
BALANCE_TOPUP_STEP=50
REFERRAL_REWARD_RUB=50
# как часто проверять списание за устройства, секунды
BALANCE_CHARGE_INTERVAL=600
PROMO_ENABLED=true
PROMO_CODES=TEST:3                  # КОД:сколько_дней, ещё коды через запятую

# ============================================================
# 6. ДОКУМЕНТЫ (кнопки-ссылки, не текст в чат)
# ============================================================
LEGAL_OFFER_URL=https://example.com/offer
LEGAL_PRIVACY_URL=https://example.com/privacy

# ============================================================
# 7. MINI APP (личный кабинет) — включать на деплое
# ============================================================
WEBAPP_ENABLED=false
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Публичный HTTPS кабинета, например https://lk.yourdomain.com
# Telegram Mini App без HTTPS не откроется
WEBAPP_PUBLIC_URL=

# ============================================================
# 8. POSTGRESQL
# ============================================================
POSTGRES_USER=rmshop
POSTGRES_PASSWORD=rmshop
POSTGRES_DB=rmshop
# Локальный запуск python -m app. В Docker Compose это поле перезаписывается на хост postgres
DATABASE_URL=postgresql://rmshop:rmshop@127.0.0.1:5432/rmshop
# Кэш карточки из панели, секунды
PANEL_SYNC_TTL=60
# Фоновая сверка с Remnawave, секунды. 0 = выключить
PANEL_SYNC_INTERVAL=600
# Кулдаун кнопки «VPN не работает», секунды
VPN_REPORT_COOLDOWN_SEC=900
# Сколько дней хранить файлы бэкапов на диске (минимум последние 7 файлов всё равно остаются)
BACKUP_KEEP_DAYS=14
